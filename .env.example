# ═══════════════════════════════════════════════════════════════════════════════════════════════
# IconicConnect — environment variables
#   cp .env.example .env     then fill in the values.   NEVER commit .env (it is git-ignored).
#   Lines marked [REQUIRED] stop the app from working if missing; the rest have safe defaults.
#   Production differences are marked  (PROD:)  — see deploy/README.md.
# ═══════════════════════════════════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────────────────────────────────────
# [REQUIRED] Public base URL. Used in the links inside password-reset / welcome emails.
# (PROD:) https://connectapp.theiconicdental.com        (local dev:) http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:4000

# ── PostgreSQL ──────────────────────────────────────────────────────────────────────────────────
# [REQUIRED] (local dev, Docker on port 5433)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/iconic_connect?sslmode=disable
# (PROD:) generated by deploy/setup-server.sh — copy it from /opt/iconic/connection.env, or let the
#         provision workflow write it (it uses 127.0.0.1:5433 and a random password).
# Connections per Node process (default 3). PM2 sets this per process in ecosystem.config.js.
DB_POOL_MAX=3

# ── Redis (sessions, rate limiting, caches, job queues) ─────────────────────────────────────────
# [REQUIRED] (local dev, Docker on port 6380)
REDIS_URL=redis://localhost:6380
# (PROD:) redis://:<password>@127.0.0.1:6380   — also generated into /opt/iconic/connection.env

# ── Cloudflare R2 (case files, scans, uploads) ──────────────────────────────────────────────────
# [REQUIRED] R2 → Manage API tokens → "Object Read & Write" token for the app's bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: serve downloads straight from R2 after the auth check (true/false, default false)
#R2_DIRECT_DOWNLOADS=false
# Optional R2 maintenance tuning
#R2_RETENTION_MONTHS=3
#R2_CLEANUP_GRACE_HOURS=2
#R2_CLEANUP_MAX_DELETE=100
# NOTE: database backups live under db-backups/ in R2 — the cleanup/retention jobs never touch that prefix.

# ── Email (Resend) ──────────────────────────────────────────────────────────────────────────────
# [REQUIRED] for password resets, welcome and notification emails
RESEND_API_KEY=
EMAIL_FROM=noreply@your-verified-domain.com

# ── Security ────────────────────────────────────────────────────────────────────────────────────
# [REQUIRED to use the first-admin sign-up page] Protects POST /api/admin/user, which needs NO login and can create
# an administrator. MUST be long and random (>= 32 chars) — shorter values disable the endpoint.
#   generate:  openssl rand -hex 32
ADMIN_SIGNUP_SECRET=

# Optional: lets you (and the deploy pipeline) see the precise reason when GET /api/health reports a problem.
# Send it as header  x-health-token: <value>.        generate:  openssl rand -hex 24
HEALTH_TOKEN=

# ── Optional tuning ─────────────────────────────────────────────────────────────────────────────
# Max total size of one bulk ZIP download in bytes (default 10 GB)
#BULK_DOWNLOAD_MAX_BYTES=10737418240
# Set to true to NOT start background workers inside the web process (PM2 production runs a separate worker)
#DISABLE_WORKER=false

# ── Used only by one-off maintenance scripts (not by the running app) ───────────────────────────
# One-time Supabase → local archive:  SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
#SUPABASE_DB_URL=
